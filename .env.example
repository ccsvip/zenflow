# ===== 端口配置 =====
# 主机对外暴露端口（浏览器访问 http://localhost:${WEB_PORT}）
WEB_PORT=3000
# 容器内 Next.js 监听端口（一般无需修改；Next 会读取 PORT 变量）
WEB_CONTAINER_PORT=3000
# 数据库端口（主机访问 localhost:${DB_PORT}）
DB_PORT=15432

# ===== 运行环境 =====
NODE_ENV=production
# Next.js 监听地址，0.0.0.0 才能从容器外访问
HOSTNAME=0.0.0.0
# 登录会话有效期（小时）
SESSION_TTL_HOURS=24

# ===== 数据库配置 =====
# PostgreSQL 数据库名称
DB_NAME=zenflow
# PostgreSQL 数据库用户名
DB_USER=zenflow
# PostgreSQL 数据库密码
DB_PASSWORD=zenflow123
